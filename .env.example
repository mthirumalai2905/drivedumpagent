# Application
APP_NAME=Back Office
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

# Dashboard login. Required. Never reuse a credential that was pasted into chat.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# DeepSeek is optional. Core Gmail and Drive processing runs without it.
# Set both values to enable AI. Do not guess the model name.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Google OAuth. Use a refresh token minted for THIS app's redirect URI.
# Revoke any token that was pasted into chat, tickets, or the OAuth Playground.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Must match an authorized redirect URI on the OAuth client exactly.
# Local example: http://127.0.0.1:8000/oauth/google/callback
# Production example: https://<your-service>.onrender.com/oauth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# Google APIs
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_GMAIL_USER=backoffice@synx.tools
# Set true only when the destination folder lives on a shared drive.
GOOGLE_DRIVE_SUPPORTS_SHARED=false

# Email processing
TRIGGER_KEYWORD=back office,backoffice
POLL_INTERVAL_SECONDS=60
POLL_ENABLED=true
EMAIL_LOOKBACK_MINUTES=1440
MAX_ATTACHMENT_BYTES=100000000
MAX_ATTACHMENTS_PER_EMAIL=20
MAX_MESSAGES_PER_CYCLE=100
# Comma-separated allowlist. application/octet-stream is intentionally omitted.
ALLOWED_MIME_TYPES=application/pdf,text/plain,text/csv,image/png,image/jpeg,image/gif,image/webp,application/zip,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-powerpoint.presentation.macroEnabled.12,application/vnd.openxmlformats-officedocument.presentationml.slideshow,application/vnd.openxmlformats-officedocument.presentationml.template,application/vnd.oasis.opendocument.presentation,application/vnd.apple.keynote,video/mp4,video/quicktime,video/webm,video/x-msvideo,video/mpeg,video/3gpp,video/x-matroska,video/ogg

# Database. Use sqlite locally and the Render Postgres URL in production.
DATABASE_URL=sqlite:///./backoffice.db

# Logging. Production on Render should keep LOG_TO_FILE=false (ephemeral disk).
LOG_LEVEL=INFO
LOG_FILE=logs/backoffice.log
LOG_TO_FILE=
